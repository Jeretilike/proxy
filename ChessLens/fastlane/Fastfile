require "base64"

default_platform(:ios)

# Registers the bundle ID (and the Wi-Fi capabilities the glasses SDK uses) if missing,
# so nothing has to be set up on developer.apple.com by hand.
def ensure_bundle_id(identifier)
  bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
  unless bundle
    UI.message("Registering bundle ID #{identifier}")
    bundle = Spaceship::ConnectAPI::BundleId.create(name: "ChessLens", platform: "IOS", identifier: identifier)
  end

  capabilities = bundle.get_capabilities
  [
    Spaceship::ConnectAPI::BundleIdCapability::Type::ACCESS_WIFI_INFORMATION,
    Spaceship::ConnectAPI::BundleIdCapability::Type::HOT_SPOT
  ].each do |type|
    next if capabilities.any? { |capability| capability.is_type?(type) }

    UI.message("Enabling #{type} for #{identifier}")
    bundle.create_capability(type)
  end
end

platform :ios do
  desc "Build ChessLens and upload it to TestFlight"
  lane :beta do
    bundle_id = ENV.fetch("BUNDLE_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    setup_ci

    key_content = ENV.fetch("ASC_KEY_CONTENT")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key_content,
      is_key_content_base64: !key_content.include?("BEGIN PRIVATE KEY")
    )

    ensure_bundle_id(bundle_id)

    # Certificates and the App Store profile live encrypted in a private Git repo, so every
    # run reuses the same distribution certificate instead of creating new ones.
    match(
      type: "appstore",
      app_identifier: bundle_id,
      team_id: team_id,
      api_key: api_key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('MATCH_GIT_TOKEN')}"),
      readonly: false
    )
    profile_name = ENV.fetch("sigh_#{bundle_id}_appstore_profile-name")

    latest = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: bundle_id, initial_build_number: 0)
    rescue StandardError => e
      UI.user_error!(
        "Couldn't read builds for #{bundle_id} from App Store Connect (#{e.message}). " \
        "Create the app first: appstoreconnect.apple.com → Apps → + → New App, and pick bundle ID #{bundle_id}."
      )
    end
    build_number = [latest.to_i + 1, ENV.fetch("GITHUB_RUN_NUMBER", "1").to_i].max

    # Signing applies to the app target only (Swift package targets must stay unsigned).
    settings = {
      "PRODUCT_BUNDLE_IDENTIFIER" => bundle_id,
      "DEVELOPMENT_TEAM" => team_id,
      "CODE_SIGN_STYLE" => "Manual",
      "CODE_SIGN_IDENTITY" => "Apple Distribution",
      "PROVISIONING_PROFILE_SPECIFIER" => profile_name,
      "CURRENT_PROJECT_VERSION" => build_number.to_s
    }
    settings["MARKETING_VERSION"] = ENV["APP_VERSION"] unless ENV["APP_VERSION"].to_s.empty?
    settings["META_APP_ID"] = ENV["META_APP_ID"] unless ENV["META_APP_ID"].to_s.empty?
    settings["META_CLIENT_TOKEN"] = ENV["META_CLIENT_TOKEN"] unless ENV["META_CLIENT_TOKEN"].to_s.empty?
    File.write("../Config/Signing.local.xcconfig", settings.map { |key, value| "#{key} = #{value}" }.join("\n") + "\n")

    build_app(
      project: "ChessLens.xcodeproj",
      scheme: "ChessLens",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: { provisioningProfiles: { bundle_id => profile_name } },
      output_directory: "build",
      xcargs: "-skipPackagePluginValidation -skipMacroValidation"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Build #{build_number} uploaded. It appears in TestFlight after Apple finishes processing (usually 5–15 minutes).")
  end
end
